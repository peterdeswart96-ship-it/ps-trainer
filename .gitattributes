# Alle tekstbestanden krijgen LF-regeleinden, ook op Windows.
# Zo blijven diffs schoon en zijn .ps1- en .json-bestanden overal gelijk.
* text=auto eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
# Officiele Microsoft-iconen: ongewijzigd laten (geen regeleinde-omzetting)
assets/img/microsoft/*.svg -text
