{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ps-trainer.pdscloud.nl/schema/script.schema.json",
  "title": "meta.json van een oefenscript",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "topic", "level", "tag", "summary", "risk", "modules", "check", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "legacyId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "topic": { "enum": ["migraties", "sharepoint", "foundry", "purview", "entra-id"] },
    "level": { "enum": ["basis", "gevorderd", "expert"] },
    "tag": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["read", "write"] },
    "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "note": { "type": "string", "minLength": 1 },
    "check": { "$ref": "#/definitions/check" },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/question" } }
  },
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["gecontroleerd", "nog_te_controleren"] },
        "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
        "source": { "type": "string", "minLength": 1 }
      },
      "if": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "gecontroleerd" } }
      },
      "then": { "type": "object", "required": ["date", "source"], "properties": { "date": true, "source": true } }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "step", "prompt", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[1-9][0-9]*$" },
        "type": { "enum": ["mc", "bug", "open"] },
        "step": { "enum": ["parameters", "bron", "bewerking", "wijziging", "uitvoer"] },
        "lines": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "prompt": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
        "answer": { "type": "integer", "minimum": 0 },
        "explanation": { "type": "string", "minLength": 1 }
      },
      "if": {
        "type": "object",
        "required": ["type"],
        "properties": { "type": { "enum": ["mc", "bug"] } }
      },
      "then": { "type": "object", "required": ["options", "answer"], "properties": { "options": true, "answer": true } },
      "else": { "type": "object", "properties": { "options": false, "answer": false } }
    }
  }
}
