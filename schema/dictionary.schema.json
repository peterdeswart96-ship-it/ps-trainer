{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ps-trainer.pdscloud.nl/schema/dictionary.schema.json",
  "title": "data/dictionary.json: het woordenboek (ook voor de flashcards)",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/groep" },
  "definitions": {
    "groep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item" } }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "explanation", "example", "risk"],
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["read", "write", "neutral"] },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["migraties", "sharepoint", "foundry", "purview", "entra-id"] }
        }
      }
    }
  }
}
